FOREACH(idl #braces( "IDL_SOURCE_C" ))
    GET_FILENAME_COMPONENT(filename #braces("idl") NAME)
    STRING(REGEX REPLACE "\\.idl" "" basename #braces("filename"))
    LIST(APPEND IDL_GEN_C #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename").#braces("SOURCE_EXTENSION");
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Plugin.#braces("SOURCE_EXTENSION");
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Support.#braces("SOURCE_EXTENSION"))
    LIST(APPEND IDL_GEN_H #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename").h
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Plugin.h;
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Support.h)
    IF (RTIME_IDL_ADD_REGENERATE_TYPESUPPORT_RULE)
        IF (NOT EXISTS #braces("idl"))
            MESSAGE(FATAL_ERROR "#braces("idl") does not exist.")
        ELSEIF(IS_DIRECTORY #braces("idl"))
            MESSAGE(FATAL_ERROR "#braces("idl") is not a file.")
        ENDIF()

        SET(IDL_GEN_FILE_C #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename").#braces("SOURCE_EXTENSION");
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Plugin.#braces("SOURCE_EXTENSION");
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Support.#braces("SOURCE_EXTENSION"))
        SET(IDL_GEN_FILE_H #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename").h;
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Plugin.h;
                          #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Support.h)
        ADD_CUSTOM_COMMAND(OUTPUT #braces("IDL_GEN_FILE_C") #braces("IDL_GEN_FILE_H")
                           COMMAND #braces("COMMAND_PREFIX") #braces("RTIDDSGEN") -language C
                                   -micro -verbosity 1 -update typefiles
                                   -d #braces("CMAKE_CURRENT_SOURCE_DIR");
                                   #braces("IDL_PATH")/#braces("idl");
                           DEPENDS #braces("IDL_PATH")/#braces("idl")
                           COMMENT "Regeneration type support plugin from #braces("idl")"
                          )
        SET_SOURCE_FILES_PROPERTIES(#braces("IDL_GEN_FILE_C") #braces("IDL_GEN_FILE_H") PROPERTIES GENERATED 1)
    ENDIF()
ENDFOREACH()

