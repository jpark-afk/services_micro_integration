${hashtag} Commented out MAG file regeneration since files already exist
IF (FALSE AND DEFINED RTIME_MAG_FILES)
    FOREACH(xml #braces("RTIME_MAG_FILES"))
        IF (NOT EXISTS #braces("xml"))
            MESSAGE(FATAL_ERROR "#braces("xml") does not exist.")
        ELSEIF(IS_DIRECTORY #braces("xml"))
            MESSAGE(FATAL_ERROR "#braces("xml") is not a file.")
        ENDIF()

        GET_FILENAME_COMPONENT(filename #braces("xml") NAME)
        STRING(REGEX REPLACE "\\.xml" "" basename #braces("filename"))
        GET_FILENAME_COMPONENT(basename #braces("xml") NAME_WE)

        STRING(REGEX REPLACE "\\.xml" "Qos.xml" xml_qos #braces("xml"))
        IF (EXISTS #braces("xml_qos"))
            IF(NOT IS_DIRECTORY #braces("xml_qos"))
                SET(REFERENCED_OPT "YES")
            ENDIF()
        ENDIF()

        LIST(APPEND APP_GEN_C #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Appgen.c)

        LIST(APPEND APP_GEN_H #braces("CMAKE_CURRENT_SOURCE_DIR")/#braces("basename")Appgen.h)


        IF (DEFINED REFERENCED_OPT)
            ADD_CUSTOM_COMMAND(OUTPUT #braces("APP_GEN_C") #braces("APP_GEN_H")
                               COMMAND #braces("COMMAND_PREFIX") #braces("RTIDDSMAG") -verbosity 1
                                       -language C
                                       -replace
                                       -d #braces("CMAKE_CURRENT_SOURCE_DIR")
                                       -idlFile #braces("IDL_PATH")/#braces("IDL_SOURCE_C")
                                       -referencedFile #braces("XML_PATH")/#braces("basename")Qos.xml;
                                       #braces("XML_PATH")/#braces("xml");
                               DEPENDS #braces("XML_PATH")/#braces("xml") #braces("XML_PATH")/#braces("basename")Qos.xml
                               COMMENT "Regeneration of application support from #braces("xml")"
            )
        ELSE()
            ADD_CUSTOM_COMMAND(OUTPUT #braces("APP_GEN_C") #braces("APP_GEN_H")
                               COMMAND #braces("COMMAND_PREFIX") #braces("RTIDDSMAG") -verbosity 1
                                       -language C
                                       -replace
                                       -d #braces("CMAKE_CURRENT_SOURCE_DIR")
                                       -idlFile #braces("IDL_PATH")/#braces("IDL_SOURCE_C");
                                       #braces("XML_PATH")/#braces("xml");
                               DEPENDS #braces("XML_PATH")/#braces("xml")
                               COMMENT "Regeneration of application support from #braces("xml")"
            )
        ENDIF()
    ENDFOREACH()
ENDIF()

IF (#braces("RTIME_SECURE"))
    ADD_CUSTOM_TARGET(security_material ALL
                      DEPENDS #braces("CMAKE_SOURCE_DIR")/security/ca/ca.pem
                              #braces("CMAKE_SOURCE_DIR")/security/ca/certs/publisher.pem;
                              #braces("CMAKE_SOURCE_DIR")/security/ca/certs/publisher_key.pem;
                              #braces("CMAKE_SOURCE_DIR")/security/ca/certs/subscriber.pem;
                              #braces("CMAKE_SOURCE_DIR")/security/ca/certs/subscriber_key.pem;
                              #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_publisher.p7s;
                              #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_subscriber.p7s;
                              #braces("CMAKE_SOURCE_DIR")/security/xml/governance.p7s;
                     )

    ADD_CUSTOM_COMMAND(OUTPUT #braces("CMAKE_SOURCE_DIR")/security/openssl_ca.cnf
                              #braces("CMAKE_SOURCE_DIR")/security/openssl_publisher.cnf;
                              #braces("CMAKE_SOURCE_DIR")/security/openssl_subscriber.cnf;
                              #braces("CMAKE_SOURCE_DIR")/security/xml/governance.xml;
                              #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_publisher.xml;
                              #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_subscriber.xml;
                       COMMAND "#braces("CMAKE_COMMAND")" -E copy_directory "#braces("RTIMEHOME")/rtiddsgen/resource/rtiddsgen/security" "security"
                       COMMENT "Copy secure configuration files"
                       WORKING_DIRECTORY #braces("CMAKE_SOURCE_DIR")
                      )

    ADD_CUSTOM_COMMAND(OUTPUT #braces("CMAKE_SOURCE_DIR")/security/ca/ca_key.pem #braces("CMAKE_SOURCE_DIR")/security/ca/ca.pem
                       COMMAND "#braces("CMAKE_COMMAND")" -E make_directory ca
                       COMMAND "#braces("CMAKE_COMMAND")" -E touch ca/index.txt
                       COMMAND echo 01 > ca/serial
                       COMMAND openssl genrsa -out ca/ca_key.pem 2048
                       COMMAND openssl req -new -key ca/ca_key.pem -out ca/ca.csr -config openssl_ca.cnf
                       COMMAND openssl x509 -req -days 365 -in ca/ca.csr -signkey ca/ca_key.pem -out ca/ca.pem
                       COMMENT "Regenerating Certificate Authority"
                       DEPENDS #braces("CMAKE_SOURCE_DIR")/security/openssl_ca.cnf
                       WORKING_DIRECTORY #braces("CMAKE_SOURCE_DIR")/security
                      )

    ADD_CUSTOM_COMMAND(OUTPUT #braces("CMAKE_SOURCE_DIR")/security/ca/certs/publisher.pem #braces("CMAKE_SOURCE_DIR")/security/ca/certs/publisher_key.pem
                       COMMAND "#braces("CMAKE_COMMAND")" -E make_directory ca/certs
                       COMMAND openssl genrsa -out ca/certs/publisher_key.pem 2048
                       COMMAND openssl req -new -key ca/certs/publisher_key.pem -out ca/certs/publisher.csr -config openssl_publisher.cnf
                       COMMAND openssl ca -batch -config openssl_ca.cnf -in ca/certs/publisher.csr -out ca/certs/publisher.pem
                       COMMENT "Regenerating Publisher identity"
                       DEPENDS #braces("CMAKE_SOURCE_DIR")/security/openssl_ca.cnf #braces("CMAKE_SOURCE_DIR")/security/openssl_publisher.cnf
                       WORKING_DIRECTORY #braces("CMAKE_SOURCE_DIR")/security
                      )

    ADD_CUSTOM_COMMAND(OUTPUT #braces("CMAKE_SOURCE_DIR")/security/ca/certs/subscriber.pem #braces("CMAKE_SOURCE_DIR")/security/ca/certs/subscriber_key.pem
                       COMMAND "#braces("CMAKE_COMMAND")" -E make_directory ca/certs
                       COMMAND openssl genrsa -out ca/certs/subscriber_key.pem 2048
                       COMMAND openssl req -new -key ca/certs/subscriber_key.pem -out ca/certs/subscriber.csr -config openssl_subscriber.cnf
                       COMMAND openssl ca -batch -config openssl_ca.cnf -in ca/certs/subscriber.csr -out ca/certs/subscriber.pem
                       COMMENT "Regenerating Subscriber identity"
                       DEPENDS #braces("CMAKE_SOURCE_DIR")/security/openssl_ca.cnf #braces("CMAKE_SOURCE_DIR")/security/openssl_subscriber.cnf
                       WORKING_DIRECTORY #braces("CMAKE_SOURCE_DIR")/security
                      )

    ADD_CUSTOM_COMMAND(OUTPUT #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_publisher.p7s
                       COMMAND openssl cms -in xml/permissions_publisher.xml -out xml/permissions_publisher.p7s -signer ca/ca.pem -inkey ca/ca_key.pem -sign -outform smime
                       COMMENT "Regenerating Publisher Permissions file"
                       DEPENDS #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_publisher.xml #braces("CMAKE_SOURCE_DIR")/security/ca/ca.pem #braces("CMAKE_SOURCE_DIR")/security/ca/ca_key.pem
                       WORKING_DIRECTORY #braces("CMAKE_SOURCE_DIR")/security
                      )

    ADD_CUSTOM_COMMAND(OUTPUT #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_subscriber.p7s
                       COMMAND openssl cms -in xml/permissions_subscriber.xml -out xml/permissions_subscriber.p7s -signer ca/ca.pem -inkey ca/ca_key.pem -sign -outform smime
                       COMMENT "Regenerating Subscriber Permissions file"
                       DEPENDS #braces("CMAKE_SOURCE_DIR")/security/xml/permissions_subscriber.xml #braces("CMAKE_SOURCE_DIR")/security/ca/ca.pem #braces("CMAKE_SOURCE_DIR")/security/ca/ca_key.pem
                       WORKING_DIRECTORY #braces("CMAKE_SOURCE_DIR")/security
                      )

    ADD_CUSTOM_COMMAND(OUTPUT #braces("CMAKE_SOURCE_DIR")/security/xml/governance.p7s
