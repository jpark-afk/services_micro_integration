#macro( DDSInitFunc )
int DDS_Init()
{
    /* Call Application_Create */
    struct Application *application = Application_create();
    if (!application)
    {
        printf("Failed to create DDS\n");
        return -1;
    }
    printf("DDS initialized successfully\n");

    return 0;
