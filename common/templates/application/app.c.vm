## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## | macro to define write function for a topic                                |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( writeFunction $datawriter $dpName $pubName)
    #set( $type = $datawriter.typeRef )
    #set( $topic = $datawriter.topicName )
/* Write ${type} data to ${topic} topic */
bool ${topic}_write(const ${type} *data)
{
    DDS_DataWriter *datawriter = NULL;
    ${type}DataWriter *hw_datawriter = NULL;
    DDS_ReturnCode_t retcode;

    if (g_application == NULL || g_application->${dpName} == NULL)
    {
        printf("Application not initialized\n");
        return false;
    }

    /* Lookup the data writer by name */
    datawriter = DDS_DomainParticipant_lookup_datawriter_by_name(
        g_application->${dpName},
        "${pubName}::${datawriter.name}");

    if (datawriter == NULL)
    {
        printf("Failed to lookup datawriter\n");
        return false;
    }

    /* Narrow to typed data writer */
    hw_datawriter = ${type}DataWriter_narrow(datawriter);
    if (hw_datawriter == NULL)
    {
        printf("Failed to narrow datawriter\n");
        return false;
    }

    /* Write the sample */
    retcode = ${type}DataWriter_write(
        hw_datawriter,
        data,
        &DDS_HANDLE_NIL);

    if (retcode != DDS_RETCODE_OK)
    {
        printf("Failed to write sample: %d\n", retcode);
        return false;
    }

    return true;
}
#end
