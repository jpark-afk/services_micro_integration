## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## | macros to define on_data_available functions for each topic               |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( onDataAvailableTopicFunction $datareader )
    #set( $type = $datareader.typeRef )
    #set( $topic = $datareader.topicName )
/* Listener callback for data available event for $topic */
static void ${topic}_on_data_available(
    void *listener_data,
    DDS_DataReader *reader)
{
    ${type}DataReader *typed_reader = NULL;
    struct DDS_SampleInfoSeq info_seq = DDS_SEQUENCE_INITIALIZER;
    struct ${type}Seq data_seq = DDS_SEQUENCE_INITIALIZER;
    DDS_ReturnCode_t retcode;
    DDS_Long i;

    typed_reader = ${type}DataReader_narrow(reader);
    if (typed_reader == NULL)
    {
        printf("Error: Failed to narrow reader\n");
        return;
    }

    /* Take all available samples */
    retcode = ${type}DataReader_take(
        typed_reader,
        &data_seq,
        &info_seq,
        DDS_LENGTH_UNLIMITED,
        DDS_ANY_SAMPLE_STATE,
        DDS_ANY_VIEW_STATE,
        DDS_ANY_INSTANCE_STATE);

    if (retcode != DDS_RETCODE_OK)
    {
        printf("Error taking data: %d\n", retcode);
        return;
    }

    /* Process each sample */
    for (i = 0; i < ${type}Seq_get_length(&data_seq); ++i)
    {
        if (DDS_SampleInfoSeq_get_reference(&info_seq, i)->valid_data)
        {
            /* Pass valid data to the read handler */
            ${topic}_read(${type}Seq_get_reference(&data_seq, i));
        }
    }

    /* Return the loan */
    retcode = ${type}DataReader_return_loan(typed_reader, &data_seq, &info_seq);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("Error returning loan: %d\n", retcode);
    }
}
#end

## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## | macro to define Application_create function                           |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Implement the selectedParticipant (The Participant Model, not the DOM participant)
#macro( applicationCreateFunc $systemModel )
struct Application *
Application_create()
{
    DDS_DomainParticipantFactory *factory = NULL;
    DDS_Boolean success = DDS_BOOLEAN_FALSE;
    struct Application *application = NULL;
    RT_Registry_T *registry = NULL;
    struct APPGEN_FactoryProperty model_xml = APPGEN_FactoryProperty_INITIALIZER;

    /* Uncomment to increase verbosity level:
    OSAPI_Log_set_verbosity(OSAPI_LOG_VERBOSITY_WARNING);
    */

    OSAPI_Heap_allocate_struct(&application, struct Application);
    if (application == NULL)
    {
        printf("failed to allocate application\n");
        goto done;
    }

    factory = DDS_DomainParticipantFactory_get_instance();

    registry = DDS_DomainParticipantFactory_get_registry(factory);

    /* This pointer must be valid as long as the Micro
    * Application Generation plugin is registered
    */
    model_xml._model = APPGEN_get_library_seq();
    if (!APPGEN_Factory_register(registry, &model_xml))
    {
        printf("failed to register Application Generation\n");
        goto done;
    }

    #foreach( $library in $systemModel.libraries )
        #foreach( $participant in $library.participants )
    application->${participant.name} =
        DDS_DomainParticipantFactory_create_participant_from_config(
            factory,
            "${participant.libraryName}::${participant.name}");

    if (application->${participant.name} == NULL)
    {
        printf("failed to create participant\n");
        goto done;
    }
        #end
    #end

    #set( $isDefined = false )
    #foreach( $library in $systemModel.libraries )
        #foreach( $participant in $library.participants )
            #foreach( $subscriber in $participant.subscribers )
                #foreach( $datareader in $subscriber.dataReaders )
                    ## Only need to define these variables once
                    #if(!$isDefined )
                        #set( $isDefined = true )
    /* Setup data reader listener */
    DDS_DataReader *datareader = NULL;
    struct DDS_DataReaderListener dr_listener = DDS_DataReaderListener_INITIALIZER;
    DDS_ReturnCode_t retcode;
                    #end

    datareader = DDS_DomainParticipant_lookup_datareader_by_name(
        application->${participant.name},
        "${subscriber.name}::${datareader.name}");

    if (datareader == NULL)
    {
        printf("failed to lookup datareader\n");
        goto done;
    }

    dr_listener.on_data_available = ${datareader.topicName}_on_data_available;

    retcode = DDS_DataReader_set_listener(
        datareader,
        &dr_listener,
        DDS_DATA_AVAILABLE_STATUS);

    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to set reader listener\n");
        goto done;
    }
                #end
            #end
        #end
    #end

    success = DDS_BOOLEAN_TRUE;

done:

    if (!success)
    {
        #ifndef RTI_CERT
        if (application != NULL)
        {
            OSAPI_Heap_free_struct(application);
        }
        #endif
        application = NULL;
    }
    else
    {
        g_application = application;
    }

    return application;
}
#end

## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## | macro to define Application_delete function                           |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( applicationDeleteFunc $application )
#ifndef RTI_CERT
void
Application_delete(struct Application *application)
{
    DDS_ReturnCode_t retcode;
    RT_Registry_T *registry = NULL;
    DDS_DomainParticipantFactory *factory = NULL;

    factory = DDS_DomainParticipantFactory_get_instance();
    registry = DDS_DomainParticipantFactory_get_registry(factory);

    #foreach( $participant in $application.domainParticipant )
    retcode = DDS_DomainParticipant_delete_contained_entities(
        application->${participant.name});
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to delete contained entities: %d\n",retcode);
    }

    retcode = DDS_DomainParticipantFactory_delete_participant(
        factory, application->${participant.name});
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to delete participant: %d\n", retcode);
        return;
    }
    #end

    if (!APPGEN_Factory_unregister(registry, NULL))
    {
        printf("failed to unregister Application Generation\n");
    }

    OSAPI_Heap_free_struct(application);

    retcode = DDS_DomainParticipantFactory_finalize_instance();
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to finalize domain participant factory: %d\n", retcode);
        return;
    }
}
#endif
#end

