#parse( "utils/utils.vm" )
## =============================================================================
## DDS System Entities (targeting header files)
## =============================================================================
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    builtinTopicKey                                                        |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( builtinTopicKey $rtpsObjectId $name )
    { \
        { 0, 0, 0, $rtpsObjectId } /* $name */ \
    }, \
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
