## |    DiscoveryQos                                                           |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( discoveryQos $discoveryQos, $qos_name )
    #if( !$discoveryQos )
        DDS_DISCOVERY_QOS_POLICY_DEFAULT, \
    #else
        #if ( $discoveryQos.initialPeers != $null )
            #set ( $initial_peers_name = ${qos_name} + "_initial_peers" )
            #set ( $initial_peers_size = $discoveryQos.initialPeers.element.size() )
        #end
        #if ( $discoveryQos.microEnabledTransports != $null )
            #set ( $enabled_transport_name = ${qos_name} + "_discovery_enabled_transports" )
            #set ( $initial_transport_size = $discoveryQos.microEnabledTransports.element.size() )
        #end
        {   /* discovery */ \
            #stringSeq( $discoveryQos.initialPeers $initial_peers_name $initial_peers_size ), /* initial_peers */ \
            #stringSeq( $discoveryQos.microEnabledTransports $enabled_transport_name $initial_transport_size ), /* enabled_transports */ \
            #discoveryComponent( $discoveryQos.discoveryName ), /* discovery_component */ \
            #ddsBoolean( $discoveryQos.acceptUnknownPeers, true ), /* accept_unknown_peers */ \
            #ddsBoolean( $discoveryQos.enableParticipantDiscoveryByName, false ), /* enable_participant_discovery_by_name */ \
            #ddsBoolean( $discoveryQos.enableEndpointDiscoveryQueue, false ), /* enable_endpoint_discovery_queue */ \
            #propertyValueWithDefault( $discoveryQos.metatrafficTransportPriority "DDS_DISCOVERY_METATRAFFIC_TRANSPORT_PRIORITY_DEFAULT" "metatraffic_transport_priority" false )
        }, \
    #end
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    DomainParticipantResourceLimitsQos                                     |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( domainParticipantResourceLimitsQos $dprlQos )
    #if( !$dprlQos )
        DDS_DOMAIN_PARTICIPANT_RESOURCE_LIMITS_QOS_POLICY_DEFAULT, \
    #else
        {   /* resource_limits  */ \
            ${dprlQos.localWriterAllocation.maxCount}L, /* local_writer_allocation */ \
            ${dprlQos.localReaderAllocation.maxCount}L, /* local_reader_allocation */ \
            ${dprlQos.localPublisherAllocation.maxCount}L, /* local_publisher_allocation */ \
            ${dprlQos.localSubscriberAllocation.maxCount}L, /* local_subscriber_allocation */ \
            ${dprlQos.localTopicAllocation.maxCount}L, /* local_topic_allocation */ \
            ${dprlQos.localTypeAllocation.maxCount}L, /* local_type_allocation */ \
            ${dprlQos.remoteParticipantAllocation.maxCount}L, /* remote_participant_allocation */ \
            ${dprlQos.remoteWriterAllocation.maxCount}L, /* remote_writer_allocation */ \
            ${dprlQos.remoteReaderAllocation.maxCount}L, /* remote_reader_allocation */ \
            ${dprlQos.matchingWriterReaderPairAllocation.maxCount}L, /* matching_writer_reader_pair_allocation */ \
            ${dprlQos.matchingReaderWriterPairAllocation.maxCount}L, /* matching_reader_writer_pair_allocation */ \
            ${dprlQos.maxReceivePorts}L, /* max_receive_ports */ \
            ${dprlQos.maxDestinationPorts}L, /* max_destination_ports */ \
            65536, /* unbound_data_buffer_size */ \
            ${dprlQos.shmemRefTransferModeMaxSegments}UL, /* shmem_ref_transfer_mode_max_segments */ \
            ${dprlQos.participantUserDataMaxLength}L, /* participant_user_data_max_length */ \
            $QosUtils.integerOrSizeAuto( "$dprlQos.participantUserDataMaxCount" ), /* participant_user_data_max_count */ \
            ${dprlQos.topicDataMaxLength}L, /* topic_data_max_length */ \
            $QosUtils.integerOrSizeAuto( "$dprlQos.topicDataMaxCount" ), /* topic_data_max_count */ \
            ${dprlQos.publisherGroupDataMaxLength}L, /* publisher_group_data_max_length */ \
            $QosUtils.integerOrSizeAuto( "$dprlQos.publisherGroupDataMaxCount" ), /* publisher_group_data_max_count */ \
            ${dprlQos.subscriberGroupDataMaxLength}L, /* subscriber_group_data_max_length */ \
            $QosUtils.integerOrSizeAuto( "$dprlQos.subscriberGroupDataMaxCount" ), /* subscriber_group_data_max_count */ \
            ${dprlQos.writerUserDataMaxLength}L, /* writer_user_data_max_length */ \
            $QosUtils.integerOrSizeAuto( "$dprlQos.writerUserDataMaxCount" ), /* writer_user_data_max_count */ \
            ${dprlQos.readerUserDataMaxLength}L, /* reader_user_data_max_length */ \
            $QosUtils.integerOrSizeAuto( "$dprlQos.readerUserDataMaxCount" ), /* reader_user_data_max_count */ \
            ${dprlQos.maxPartitions}L, /* max_partitions */ \
            ${dprlQos.maxPartitionCumulativeCharacters}L, /* max_partition_cumulative_characters */ \
            $QosUtils.integerOrLengthUnlimitedToCpp( "$dprlQos.maxPartitionStringSize" ), /* max_partition_string_size */ \
            $QosUtils.integerOrLengthUnlimitedToCpp( "$dprlQos.maxPartitionStringAllocation" ), /* max_partition_string_allocation */ \
            ${dprlQos.participantPropertyListMaxLength}L, /* participant_property_list_max_length */ \
            ${dprlQos.participantPropertyStringMaxLength}L, /* participant_property_string_max_length */ \
            ${dprlQos.writerPropertyListMaxLength}L, /* writer_property_list_max_length */ \
            ${dprlQos.writerPropertyStringMaxLength}L, /* writer_property_string_max_length */ \
            ${dprlQos.readerPropertyListMaxLength}L, /* reader_property_list_max_length */ \
            ${dprlQos.readerPropertyStringMaxLength}L /* reader_property_string_max_length */ \
        }, \
    #end
#end
