## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    FilterQos                                                              |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( filterQosPolicy $filterQosPolicyValue )
    #if( !$filterQosPolicyValue )
        ,DDS_FilterQosPolicy_INITIALIZER \
    #else
        ,{ /* filter */ \
            DDS_FILTER_PLUGIN_FACTORY_DEFAULT_ID, /* name */ \
            #filterQosPolicyResourceLimits( $filterQosPolicyValue.resourceLimits )
            #ddsBoolean(${filterQosPolicyValue.disableWriterFiltering}, false), /* disable_writer_filtering */ \
            ## If the user set sqlPredicateMaxCountPerExpression in XML, the
            ## builtin SQL filter must be disabled here so we can re-register
            ## it below with a DDS_SqlFilterProperty carrying the custom value.
            ## An explicit user-set disableBuiltinSqlFilter=TRUE also wins.
            #if( $filterQosPolicyValue.sqlPredicateMaxCountPerExpression
                 || $filterQosPolicyValue.disableBuiltinSqlFilter )
                DDS_BOOLEAN_TRUE /* disable_builtin_sql_filter */ \
            #else
                #ddsBoolean(${filterQosPolicyValue.disableBuiltinSqlFilter}, false) /* disable_builtin_sql_filter */ \
            #end
        } \
    #end
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    SqlFilterProperty                                                      |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Emits the DDS_SqlFilterProperty companion variable when the user has
## set sqlPredicateMaxCountPerExpression in XML AND has not explicitly
## disabled the builtin SQL filter. The variable is referenced by the
## APPGEN_ContentFilterRegistration array in entities.h.vm.
#macro( sqlFilterProperty $sqlPredMaxCount $userDisabledBuiltin $name )
    #if( $sqlPredMaxCount && !$userDisabledBuiltin )

        ${hashtag}if DDS_ENABLE_SQL_FILTER
        static const struct DDS_SqlFilterProperty
            ${name}_sql_filter_prop =
        {
            ${sqlPredMaxCount}L
        };
        ${hashtag}endif /* DDS_ENABLE_SQL_FILTER */
    #end
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    ContentFilterQos                                                       |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( contentFilterQosPolicy $contentFilterValueQos, $qos_name )
    #if( !$contentFilterValueQos )
        DDS_CONTENT_FILTER_QOS_POLICY_DEFAULT, \
    #else
        #if ( $contentFilterValueQos.expressionParameters != $null )
            #set ( $expression_parameters_name = ${qos_name} + "_expression_parameters" )
            #set ( $expression_parameters_size = $contentFilterValueQos.expressionParameters.element.size() )
        #end
        { /* content_filter */ \
            "${contentFilterValueQos.name}", /* filter_name */ \
            "$ConverterUtils.convertFilterKind( $contentFilterValueQos.kind )", /* filter_class_name */ \
            "${contentFilterValueQos.expression}", /* filter_expression */ \
            #stringSeq( $contentFilterValueQos.expressionParameters $expression_parameters_name $expression_parameters_size ) /* expression_parameters */ \
        }, \
    #end
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    ContentFilterProperty                                                       |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( contentFilterProperty $topic_name, $contentFilterValueQos, $qos_name )
    #if( !$contentFilterValueQos )
        DDS_CONTENT_FILTER_PROPERTY_DEFAULT \
    #else
        #if ( $contentFilterValueQos.expressionParameters != $null )
            #set ( $expression_parameters_name = ${qos_name} + "_expression_parameters" )
            #set ( $expression_parameters_size = $contentFilterValueQos.expressionParameters.element.size() )
        #end
        { /* content_filter */ \
            "$ConverterUtils.getContentFilteredTopicName( $topic_name, $contentFilterValueQos.name )", /* content_filtered_topic_name */ \
            "${topic_name}", /* related_topic_name */ \
            "$ConverterUtils.convertFilterKind( $contentFilterValueQos.kind )", /* filter_class_name */ \
            "${contentFilterValueQos.expression}", /* filter_expression */ \
            #stringSeq( $contentFilterValueQos.expressionParameters $expression_parameters_name $expression_parameters_size ) /* expression_parameters */ \
        } \
    #end
#end
