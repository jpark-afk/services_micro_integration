## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    DpseDiscoveryProperties                                                |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( dpseDiscovery $dpseDiscovery $name )
    ${hashtag}define $name \
    { \
    #if( $QosUtils.isEveryFieldNull( $dpseDiscovery )  )
        DPSE_DiscoveryPluginProperty_INITIALIZER \
    #else
        RT_ComponentFactoryProperty_INITIALIZER, /* _parent */ \
        {   /*participant_liveliness_assert_period */ \
            #duration( $dpseDiscovery.participantLivelinessAssertPeriod, "30", "0" )
        }, \
        {   /*participant_liveliness_lease_duration */ \
            #duration( $dpseDiscovery.participantLivelinessLeaseDuration, "100", "0" )
        }, \
        $dpseDiscovery.initialParticipantAnnouncements, /* initial_participant_announcements */ \
        {   /*initial_participant_announcement_period */ \
            #duration( $dpseDiscovery.initialParticipantAnnouncementPeriod, "1", "0" )
        }, \
        $QosUtils.integerOrLengthAutoToCpp( $dpseDiscovery.maxParticipantLocators ), /* max_participant_locators */ \
        $dpseDiscovery.maxLocatorsPerDiscoveredParticipant#if( $dpseDiscovery.participantMessageReaderReliabilityKind ),#end /* max_locators_per_discovered_participant */ \
        #if( !$dpseDiscovery.participantMessageReaderReliabilityKind )
            DDS_PARTICIPANT_MESSAGE_READER_RELIABILITY_KIND_INITIALIZER \
        #else
            #enum( $dpseDiscovery.participantMessageReaderReliabilityKind ) /* participant_message_reader_reliability_kind */ \
        #end
    #end
    }
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    DpdeDiscoveryProperties                                                |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( dpdeDiscovery $dpdeDiscovery $name )
    ${hashtag}define $name \
    { \
    #if( $QosUtils.isEveryFieldNull( $dpdeDiscovery ) )
        DPDE_DiscoveryPluginProperty_INITIALIZER \
    #else
        RT_ComponentFactoryProperty_INITIALIZER, /* _parent */ \
        {   /*participant_liveliness_assert_period */ \
            #duration( $dpdeDiscovery.participantLivelinessAssertPeriod, "30", "0" )
        }, \
        {   /*participant_liveliness_lease_duration */ \
            #duration( $dpdeDiscovery.participantLivelinessLeaseDuration, "100", "0" )
        }, \
        $dpdeDiscovery.initialParticipantAnnouncements, /* initial_participant_announcements */ \
        {   /*initial_participant_announcement_period */ \
            #duration( $dpdeDiscovery.initialParticipantAnnouncementPeriod, "1", "0" )
        }, \
        #ddsBoolean( $dpdeDiscovery.cacheSerializedSamples, false ), /* cache_serialized_samples */ \
        $QosUtils.integerOrLengthAutoToCpp( $dpdeDiscovery.maxParticipantLocators ), /* max_participant_locators */ \
        $dpdeDiscovery.maxLocatorsPerDiscoveredParticipant, /* max_locators_per_discovered_participant */ \
        $dpdeDiscovery.maxSamplesPerBuiltinEndpointReader, /* max_samples_per_builtin_endpoint_reader */ \
        $dpdeDiscovery.maxSamplesPerRemoteBuiltinEndpointWriter, /* max_samples_per_remote_builtin_endpoint_writer */ \
        $QosUtils.integerOrLengthUnlimitedToCpp( $dpdeDiscovery.builtinWriterMaxHeartbeatRetries ), /* builtin_writer_max_heartbeat_retries */ \
        {   /*builtin_writer_heartbeat_period */ \
            #duration( $dpdeDiscovery.builtinWriterHeartbeatPeriod, "0", "100000000" )
        }, \
        $QosUtils.integerOrLengthUnlimitedToCpp( $dpdeDiscovery.builtinWriterHeartbeatsPerMaxSamples ), /* builtin_writer_heartbeats_per_max_samples */ \
        {   /* builtin_endpoint_reader_nack_period */ \
            #duration( $dpdeDiscovery.builtinEndpointReaderNackPeriod, "0", "50000000" )
        }#if( $dpdeDiscovery.participantMessageReaderReliabilityKind ),#end \
        #if( !$dpdeDiscovery.participantMessageReaderReliabilityKind )
            DDS_PARTICIPANT_MESSAGE_READER_RELIABILITY_KIND_INITIALIZER \
        #else
            #enum( $dpdeDiscovery.participantMessageReaderReliabilityKind ) /* participant_message_reader_reliability_kind */ \
        #end
    #end
    }
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    UDP_InterfaceFactoryProperty                                           |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( UDPInterfaceTableEntry $entry, $name )
    #foreach( $element in $entry )
        #set ( $element_name = $name + $foreach.count )
        ${hashtag}define $element_name \
        { \
            $element.flags, /* flags */ \
            $ConverterUtils.convertIpv4AddressToHex( $element.address ), /* address */ \
            $ConverterUtils.convertIpv4AddressToHex( $element.netMask ), /* netmask */ \
            "${element.interfaceName}" /* ifname */ \
        }
        #if( $foreach.hasNext )

        #end
    #end
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    UDP_InterfaceFactoryProperty                                           |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( udpv4 $udpInterfaceFactory, $name )
    #if( $udpInterfaceFactory != $null)
        #splitComponentName( $name )
        ## Checking if we need to add a variable to include the allowInterface or not
        #if ( $udpInterfaceFactory.allowInterface != $null )
            #set ( $allow_interface_name = ${component_name} + "_allow_interface" )
            #set ( $allow_interface_size = $udpInterfaceFactory.allowInterface.element.size() )
            extern const char *const ${allow_interface_name}[${allow_interface_size}];
        #end
        ## Checking if we need to add a variable to include the denyInterface or not
        #if ( $udpInterfaceFactory.denyInterface != $null )
            #set ( $deny_interface_name = ${component_name} + "_deny_interface" )
            #set ( $deny_interface_size = $udpInterfaceFactory.denyInterface.element.size() )
            extern const char *const ${deny_interface_name}[${deny_interface_size}];
        #end
        ## Checking if we need to add a variable to include the interface table or not
        #if ( $udpInterfaceFactory.interfaceTable != $null )
            #set ( $interface_table_name = ${component_name} + "_interface_table" )
            #set ( $interface_table_size = $udpInterfaceFactory.interfaceTable.element.size() )
            extern const struct UDP_InterfaceTableEntry ${interface_table_name}[${interface_table_size}];

            #UDPInterfaceTableEntry( $udpInterfaceFactory.interfaceTable.element, $interface_table_name )
        #end
    #end

    /**
     * NOTE: Do not add a comma (,) after UDP_NAT_INITIALIZER, it is
     * part of the definition based on the RTI_CERT definition.
     */
    ${hashtag}define $name \
    { \
    #if( !$udpInterfaceFactory )
        UDP_InterfaceFactoryProperty_INITIALIZER \
    #else
        NETIO_InterfaceFactoryProperty_INITIALIZER, \
        #redaStringSeq( $udpInterfaceFactory.allowInterface $allow_interface_name $allow_interface_size ), /* allow_interface */ \
        #redaStringSeq( $udpInterfaceFactory.denyInterface $deny_interface_name $deny_interface_size ), /* deny_interface */ \
        $udpInterfaceFactory.maxSendBufferSize, /* max_send_buffer_size */ \
        $udpInterfaceFactory.maxReceiveBufferSize, /* max_receive_buffer_size */ \
        $udpInterfaceFactory.maxMessageSize, /* max_message_size */ \
        UDP_MAX_SEND_MESSAGE_SIZE_DEFAULT /* max_send_message_size */ \
        $udpInterfaceFactory.multicastTtl, /* multicast_ttl */ \
        UDP_NAT_INITIALIZER \
        #interfaceTableSeq( $udpInterfaceFactory.interfaceTable $interface_table_name $interface_table_size ), /* if_table */ \
        #redaString( $udpInterfaceFactory.multicastInterface ), /* multicast_interface */ \
        #ddsBoolean( $udpInterfaceFactory.isDefaultInterface, true ), /* is_default_interface */ \
        #ddsBoolean( $udpInterfaceFactory.disableAutoInterfaceConfig, false ), /* disable_auto_interface_config */ \
        #ddsBoolean( $udpInterfaceFactory.multicastLoopbackDisabled, false ), /* multicast_loopback_disabled */ \
        #threadProperty( $udpInterfaceFactory.recvThread, "UDP_THREAD_PROPERTY_DEFAULT", "recv_thread", false )
        UDP_INTERFACE_BIND_DEFAULT, /* enable_interface_bind */ \
        #ddsBoolean( $udpInterfaceFactory.disableMulticastBind, false ), /* disable_multicast_bind */ \
        #ddsBoolean( $udpInterfaceFactory.disableMulticastInterfaceSelect, false ), /* disable_multicast_interface_select */ \
        UDP_TRANSFORMS_INITIALIZER \
        #propertyValueWithDefault( $udpInterfaceFactory.transportPriorityMappingLow "UDP_TRANSPORT_PRIORITY_MAPPING_LOW_DEFAULT" "transport_priority_mapping_low" true )
        #propertyValueWithDefault( $udpInterfaceFactory.transportPriorityMappingHigh "UDP_TRANSPORT_PRIORITY_MAPPING_HIGH_DEFAULT" "transport_priority_mapping_high" true )
        #propertyValueWithDefault( $udpInterfaceFactory.transportPriorityMask "UDP_TRANSPORT_PRIORITY_MASK_DEFAULT" "transport_priority_mapping_mask" true )
        #propertyValueWithDefault( $udpInterfaceFactory.maxUnicastSendSockets "UDP_MAX_UNICAST_SEND_SOCKETS_DEFAULT" "max_unicast_send_sockets" false )
    #end
    }
#end
