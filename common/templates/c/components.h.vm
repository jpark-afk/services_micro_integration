## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    ZCOPY_NotifInterfaceFactoryProperty                                    |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( zcopy $zcopyInterfaceFactory, $name )
    #if( $zcopyInterfaceFactory )
        #if ( $zcopyInterfaceFactory.userIntf && !$DISABLE_USER_INTF )
            ${hashtag}define ${name}_NOTIF_USER_INTERFACE \
            { \
                $zcopyInterfaceFactory.userIntf.createInstance, /* create_instance */ \
                $zcopyInterfaceFactory.userIntf.deleteInstance, /* delete_instance */ \
                $zcopyInterfaceFactory.userIntf.resolveAddress, /* resolve_address */ \
                $zcopyInterfaceFactory.userIntf.getRouteTable, /* get_route_table */ \
                $zcopyInterfaceFactory.userIntf.reserveAddress, /* reserve_address */ \
                $zcopyInterfaceFactory.userIntf.releaseAddress, /* release_address */ \
                $zcopyInterfaceFactory.userIntf.addRoute, /* add_route */ \
                $zcopyInterfaceFactory.userIntf.deleteRoute, /* delete_route */ \
                $zcopyInterfaceFactory.userIntf.bind, /* bind */ \
                $zcopyInterfaceFactory.userIntf.unbind, /* unbind */ \
                $zcopyInterfaceFactory.userIntf.send, /* send */ \
                $zcopyInterfaceFactory.userIntf.notifyRecvPort /* notify_recv_port */ \
            }

            extern const struct ZCOPY_NotifUserInterfaceI ${zcopyInterfaceFactory.name}_user_intf;
        #end

        #if ( $zcopyInterfaceFactory.userProperty )
            ${hashtag}define ${name}_NOTIF_USER_PROPERTY \
            { \
                ${zcopyInterfaceFactory.userProperty.intfAddr}U, /* intf_addr */ \
                #threadProperty( $zcopyInterfaceFactory.userProperty.threadProp, "OSAPI_ThreadProperty_INITIALIZER", "thread_prop", true )
                ${zcopyInterfaceFactory.userProperty.maxReceivePorts}U, /* max_receive_ports */ \
                ${zcopyInterfaceFactory.userProperty.maxRoutes}U /* max_routes */ \
            }

            extern const struct ZCOPY_NotifMechanismProperty ${zcopyInterfaceFactory.name}_user_property;
        #end
    #end

    ${hashtag}define ${name}_PROPERTY \
    { \
    #if( !$zcopyInterfaceFactory )
        ZCOPY_NotifInterfaceFactoryProperty_INITIALIZER \
    #else
        NETIO_InterfaceFactoryProperty_INITIALIZER, \
        ${zcopyInterfaceFactory.maxSamplesPerNotif}L, /* max_samples_per_notif */ \
        #if( !$zcopyInterfaceFactory.userIntf || $DISABLE_USER_INTF )NULL#else&${zcopyInterfaceFactory.name}_user_intf#end, /* user_intf */ \
        #if( !$zcopyInterfaceFactory.userProperty )NULL#else&${zcopyInterfaceFactory.name}_user_property#end /* user_property */ \
    #end
    }

    ${hashtag}define $name \
    { \
    #if( !$zcopyInterfaceFactory )
        ZCOPY_NotifLoaderFactoryProperty_INITIALIZER \
    #else
        ${name}_PROPERTY, /* _parent */ \
        "${zcopyInterfaceFactory.name}" /* notif_transport_name */ \
    #end
    }
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    DDS_PskServiceFactoryProperty                                           |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( psk $pskFactory, $name )
    #if( $pskFactory )
        #if ( $pskFactory.pslConfig && !$DISABLE_PSL_CONFIG )
            #if ( $pskFactory.pslConfig.errorListener )
                ${hashtag}define ${name}_PSL_CONFIG_ERROR_LISTENER \
                { \
                    #if( !$pskFactory.pslConfig.errorListener.callback )NULL#else$pskFactory.pslConfig.errorListener.callback#end, /* callback */
                    #if( !$pskFactory.pslConfig.errorListener.userPtr )NULL#else&$pskFactory.pslConfig.errorListener.userPtr#end /* user_ptr */
                }

                extern const struct PSK_ErrListener ${pskFactory.name}_configuration_err_listener;
            #end

            ${hashtag}define ${name}_PSL_CONFIG \
            { \
                #if( !$pskFactory.pslConfig.providerName )NULL#else"$pskFactory.pslConfig.providerName"#end, /* provider_name */
                #if( !$pskFactory.pslConfig.errorListener )NULL#else&${pskFactory.name}_configuration_err_listener#end /* err_listener */
            }

            extern const struct DDS_SecTransform_Configuration ${pskFactory.name}_configuration;
        #end

        #if ( $pskFactory.passTrackerConfig && !$DISABLE_PSL_CONFIG )
            #if ( $pskFactory.passTrackerConfig.errorListener )
                ${hashtag}define ${name}_PASS_TRACKER_CONFIG_ERROR_LISTENER \
                { \
                    #if( !$pskFactory.passTrackerConfig.errorListener.callback )NULL#else$pskFactory.passTrackerConfig.errorListener.callback#end, /* callback */
                    #if( !$pskFactory.passTrackerConfig.errorListener.userPtr )NULL#else&$pskFactory.passTrackerConfig.errorListener.userPtr#end /* user_ptr */
                }

                extern struct PSK_FilePassTrackerErrListener ${pskFactory.name}_pass_tracker_configuration_err_listener;
            #end

            #set( $passTrackerEnableInitRead = "RTI_TRUE" )
            #if( $pskFactory.passTrackerConfig.enableInitRead != $null && !$pskFactory.passTrackerConfig.enableInitRead )
                #set( $passTrackerEnableInitRead = "RTI_FALSE" )
            #end

            ${hashtag}define ${name}_PASS_TRACKER_CONFIG \
            { \
                #if( !$pskFactory.passTrackerConfig.pollingIntervalMs )100#else$pskFactory.passTrackerConfig.pollingIntervalMs#end, /* polling_interval_ms */
                $passTrackerEnableInitRead, /* enable_init_read */
                #if( !$pskFactory.passTrackerConfig.errorListener ){ NULL, NULL }#else${name}_PASS_TRACKER_CONFIG_ERROR_LISTENER#end /* err_listener */
            }

            extern struct PSK_PassTrackerConfiguration ${pskFactory.name}_pass_tracker_configuration;
        #end
    #end

    ${hashtag}define ${name} \
    { \
    #if( !$pskFactory )
        DDS_PskServiceFactoryProperty_INITIALIZER \
    #else
        RT_ComponentFactoryProperty_INITIALIZER, \
        "${pskFactory.name}", /* service_name */ \
        #if( !$pskFactory.pslGetInterfaceFunc)PSK_OSSL_get_interface#else&${pskFactory.pslGetInterfaceFunc}#end, /* psl_get_interface_func */ \
        #if( !$pskFactory.pslConfig || $DISABLE_PSL_CONFIG )NULL#else&${pskFactory.name}_configuration#end, /* psl_config */ \
        #if( !$pskFactory.passTrackerGetInterfaceFunc )PSK_FilePassTracker_get_interface#else&${pskFactory.passTrackerGetInterfaceFunc}#end, /* pass_tracker_get_interface_func */ \
        #if( !$pskFactory.passTrackerConfig || $DISABLE_PSL_CONFIG )NULL#else&${pskFactory.name}_pass_tracker_configuration#end /* pass_tracker_config */ \
    #end
    }
#end
