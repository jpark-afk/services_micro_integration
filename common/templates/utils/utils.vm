## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    Helper macro for property values with defaults                        |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## This macro outputs a property value or its default with consistent formatting
## Parameters:
##   $value - the property value (may be null)
##   $default - the default value to use if $value is null
##   $comment - the comment text for the property
##   $hasComma - whether to include a trailing comma (true/false)
#macro( propertyValueWithDefault $value $default $comment $hasComma )
#if( $value != $null )$value#{else}$default#end#if($hasComma),#end /* $comment */ \
#end

