## |    Mask                                                                   |
## A mask is a list of enums separated by |, the following macro adds DDS_ to
## each enum
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( mask $mask )
    #foreach( $enum in $mask.split("[|]") )DDS_${enum.trim()}#if( $foreach.hasNext ) | #end#end
#end
