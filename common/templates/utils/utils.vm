## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( ddsProductVersion $ddsProductVersion )
    #if( !$ddsProductVersion )
        DDS_PRODUCTVERSION_UNKNOWN \
    #else
        {   /* pro_minimum_compatiblity_version */ \
            '$ddsProductVersion.major', /* major */ \
            '$ddsProductVersion.minor', /* minor */ \
            '$ddsProductVersion.release', /* release */ \
            '$ddsProductVersion.revision' /* revision */ \
        }  \
    #end
#end
