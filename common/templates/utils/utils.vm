## |    OSAPI_ThreadProperty                                            |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( threadProperty $threadProperty, $defaultValue, $comment, $comma )
    #if( !$threadProperty )
        $defaultValue#if( $comma ),#end \
    #else
        {   /* ${comment} */ \
            $threadProperty.stackSize, /* stack_size */ \
            $threadProperty.priority, /* priority */ \
            $threadProperty.mask /* options */ \
        }#if( $comma ),#end  \
    #end
#end
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## |    Duration                                                               |
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( duration $duration $defaultSec $defaultNanosec )
    #if( !$duration )
        ${defaultSec}L, /* sec */ \
        ${defaultNanosec}UL /* nanosec */ \
    #else
        #if( $QosUtils.isInfiniteDuration( $duration.sec ) )
            DDS_DURATION_INFINITE_SEC_INITIALIZER, /* sec */ \
        #else
            #if( !$duration.sec )
                ${defaultSec}L, /* sec */ \
            #else
                ${duration.sec}L, /* sec */ \
            #end
        #end
        #if( $QosUtils.isInfiniteDuration( $duration.nanosec ) )
            DDS_DURATION_INFINITE_NSEC_INITIALIZER /* nanosec */ \
        #else
            #if( !$duration.nanosec )
                ${defaultNanosec}L /* nanosec */ \
            #else
                ${duration.nanosec}L /* nanosec */ \
            #end
        #end
    #end
#end
