                    <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                    <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                    <DATA-SEND-POINTS>
                        <VARIABLE-ACCESS>
                        <SHORT-NAME>SEND_S_${datareader.topicName}_${datareader.typeRef}</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                            <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/ComponentTypes/DdsCddType/S_$datareader.topicName</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/$datareader.topicName/$datareader.typeRef</TARGET-DATA-PROTOTYPE-REF>
                            </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                        </VARIABLE-ACCESS>
                    </DATA-SEND-POINTS>
                    <SYMBOL>Read_$datareader.topicName</SYMBOL>
                    </RUNNABLE-ENTITY>
                    #end
                   #end
                  #end
                #end
                <!-- Workaround#Common - overrun issue
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Run</SHORT-NAME>
                  <CAN-ENTERS>
                    <EXCLUSIVE-AREA-REF-CONDITIONAL>
                      <EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/ExclusiveArea_tick</EXCLUSIVE-AREA-REF>
                    </EXCLUSIVE-AREA-REF-CONDITIONAL>
                    <EXCLUSIVE-AREA-REF-CONDITIONAL>
                      <EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/ExclusiveArea_system</EXCLUSIVE-AREA-REF>
                    </EXCLUSIVE-AREA-REF-CONDITIONAL>
                  </CAN-ENTERS>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <SYMBOL>Run</SYMBOL>
                </RUNNABLE-ENTITY>
                -->
                <!-- Workaround#Common - overrun issue -->
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>TimerTick</SHORT-NAME>
                  <CAN-ENTERS>
                    <EXCLUSIVE-AREA-REF-CONDITIONAL>
                      <EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/ExclusiveArea_tick</EXCLUSIVE-AREA-REF>
                    </EXCLUSIVE-AREA-REF-CONDITIONAL>
                    <EXCLUSIVE-AREA-REF-CONDITIONAL>
                      <EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/ExclusiveArea_system</EXCLUSIVE-AREA-REF>
                    </EXCLUSIVE-AREA-REF-CONDITIONAL>
                  </CAN-ENTERS>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <INTERNAL-TRIGGERING-POINTS>
                    <INTERNAL-TRIGGERING-POINT>
                      <SHORT-NAME>ITP_TimerUpdate</SHORT-NAME>
                      <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                    </INTERNAL-TRIGGERING-POINT>
                  </INTERNAL-TRIGGERING-POINTS>
                  <SYMBOL>TimerTick</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Start</SHORT-NAME>
                  <ADMIN-DATA>
                    <SDGS>
                      <SDG GID="edve:RunnableKind">
                        <SD>InitRunnable</SD>
                      </SDG>
                    </SDGS>
                  </ADMIN-DATA>
                  <CAN-ENTERS>
                    <EXCLUSIVE-AREA-REF-CONDITIONAL>
                      <EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/ExclusiveArea_system</EXCLUSIVE-AREA-REF>
                    </EXCLUSIVE-AREA-REF-CONDITIONAL>
                    <EXCLUSIVE-AREA-REF-CONDITIONAL>
                      <EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/ExclusiveArea_heap</EXCLUSIVE-AREA-REF>
                    </EXCLUSIVE-AREA-REF-CONDITIONAL>
                  </CAN-ENTERS>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <SYMBOL>Start</SYMBOL>
                </RUNNABLE-ENTITY>                
        #foreach( $library in $systemModel.libraries )
            #foreach( $participant in $library.participants )
            #foreach( $publisher in $participant.publishers )
                #foreach( $datawriter in $publisher.dataWriters )
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Write_$datawriter.topicName</SHORT-NAME>
                  <CAN-ENTERS>
                    <EXCLUSIVE-AREA-REF-CONDITIONAL>
                      <EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/ExclusiveArea_heap</EXCLUSIVE-AREA-REF>
                    </EXCLUSIVE-AREA-REF-CONDITIONAL>
