                </RUNNABLE-ENTITY>
              </RUNNABLES>
              <SUPPORTS-MULTIPLE-INSTANTIATION>false</SUPPORTS-MULTIPLE-INSTANTIATION>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
          <SYMBOL-PROPS>
            <SHORT-NAME>DdsCdd</SHORT-NAME>
            <SYMBOL>DdsCdd</SYMBOL>
          </SYMBOL-PROPS>
        </COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE>
        <SWC-IMPLEMENTATION>
