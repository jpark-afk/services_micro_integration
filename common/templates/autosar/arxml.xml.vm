                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/Read_$datareader.topicName</START-ON-EVENT-REF>
                  <!-- TODO: Adjust OFFSET and PERIOD values if needed -->
                  <OFFSET>$offset</OFFSET>
                  <PERIOD>0.1</PERIOD>
                </TIMING-EVENT>
                      #set( $offset = $offset + 0.002 )
                    #end
                  #end
                #end
              #end
                <TIMING-EVENT>
                  <SHORT-NAME>TMT_DdsCdd_Run</SHORT-NAME>
                  <!-- Workaround#Common - overrun issue -->
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/DdsCddType/DdsCddType_InternalBehavior/TimerTick</START-ON-EVENT-REF>
                  <OFFSET>0.002</OFFSET>
                  <PERIOD>0.01</PERIOD>
