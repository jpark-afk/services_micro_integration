                #foreach( $datawriter in $publisher.dataWriters )
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>R_$datawriter.topicName</SHORT-NAME>
                  <REQUIRED-COM-SPECS>
                    <NONQUEUED-RECEIVER-COM-SPEC>
                      <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/$datawriter.topicName/$datawriter.typeRef</DATA-ELEMENT-REF>
