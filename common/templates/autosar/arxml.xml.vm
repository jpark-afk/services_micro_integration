    <AR-PACKAGE>
      <SHORT-NAME>PortInterfaces</SHORT-NAME>
      <ELEMENTS>
      <!-- For each reader/writer topic combo will need an entry for reader/writer -->
        #foreach( $topicEntry in $topicsList)
          <SENDER-RECEIVER-INTERFACE>
            <SHORT-NAME>$topicEntry.get(0)</SHORT-NAME>
            <IS-SERVICE>false</IS-SERVICE>
            <DATA-ELEMENTS>
              <VARIABLE-DATA-PROTOTYPE >
              <SHORT-NAME>$topicEntry.get(1)</SHORT-NAME>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                <SW-DATA-DEF-PROPS-CONDITIONAL>
                  <SW-CALIBRATION-ACCESS>NOT-ACCESSIBLE</SW-CALIBRATION-ACCESS>
                  <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/dds/$topicEntry.get(1)</TYPE-TREF>
              </VARIABLE-DATA-PROTOTYPE>
            </DATA-ELEMENTS>
            <!-- Workaround#HAE - delete unnecessary elements
            <INVALIDATION-POLICYS>
              <INVALIDATION-POLICY>
              <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/$topicEntry.get(0)/$topicEntry.get(1)</DATA-ELEMENT-REF>
              <HANDLE-INVALID>DONT-INVALIDATE</HANDLE-INVALID>
              </INVALIDATION-POLICY>
            </INVALIDATION-POLICYS>
            -->
          </SENDER-RECEIVER-INTERFACE>
        #end
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>

