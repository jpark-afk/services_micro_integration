## macro to generate the static variables for the dds_impl.c file
#macro( ddsImplCStaticVariables )
    /*==============================================================================
     *                            STATIC VARIABLES
     *============================================================================*/

    /**
     * @brief struct containing DDS DomainParticipant
     * 
     * Represents this application's connection to the DDS domain. Created by
     * DdsImpl_CreateEntities() and persists for application lifetime. Must be enabled
     * explicitly via DdsImpl_EnableEntities() before communication can begin.
     */
    static struct Application *application = NULL;

    ${hashtag}if (OSAPI_ENABLE_LOG == 1 && OSAPI_ENABLE_TRACE == 1)
    /**
     * @brief Custom log write function for RTI DDS Micro logging
     * 
     * Routes DDS log messages through printf for output.
     * 
     * @param buffer Log message buffer
     * @param length Length of the message
     */
    void my_log_write_function(const char* buffer, RTI_SIZE_T length) {
        printf("%s\n", buffer);
    }
    ${hashtag}endif
#end

## macro to implement the DdsImpl_CreateEntities function
#macro( ddsImplC_DdsImpl_CreateEntities $systemModel )
    int DdsImpl_CreateEntities()
    {
        DDS_DomainParticipantFactory *factory = NULL;

        RT_Registry_T *registry = NULL;
        struct APPGEN_FactoryProperty model_xml = APPGEN_FactoryProperty_INITIALIZER;
        char *participant_name = NULL;
        
        ${hashtag}if (OSAPI_ENABLE_LOG == 1 && OSAPI_ENABLE_TRACE == 1)
            /* Configure RTI DDS Micro logging */
            struct OSAPI_LogProperty property;
            OSAPI_Log_get_property(&property);
            property.write_buffer = my_log_write_function;
            OSAPI_Log_set_verbosity(OSAPI_LOG_VERBOSITY_ERROR);
            if (!OSAPI_Log_set_property(&property)) {
                printf("Failed to set log property\n");
            }
        ${hashtag}endif

        OSAPI_Heap_allocate_buffer(
                (char **)&application,
                sizeof(struct Application),
                OSAPI_ALIGNMENT_DEFAULT);
        if (application == NULL)
        {
            printf("failed to allocate application\n");
            return -1;
        }
        
        /* Retrieve Domain Participant Factory and registry */
        factory = DDS_DomainParticipantFactory_get_instance();
        registry = DDS_DomainParticipantFactory_get_registry(factory);
        
        /* Register Appgen */
        model_xml._model = APPGEN_get_library_seq();
        if (!APPGEN_Factory_register(registry, &model_xml))
        {
            printf("DdsImpl_CreateEntities: failed to register Application Generation\n");
            return -1;
        }
        
        /* Create participant from XML profile */
        #foreach( $library in $systemModel.libraries )
            #foreach( $participant in $library.participants )
        participant_name = "${participant.libraryName}::${participant.name}";
        application->${participant.name} =
            DDS_DomainParticipantFactory_create_participant_from_config(
                factory,
                participant_name);

        if (application->${participant.name} == NULL)
        {
            printf("DdsImpl_CreateEntities: failed to create participant %s\n",
                    participant_name);
            return -1;
        }
            #end
        #end
        
        return 0;
    }
#end

## macro to implement the DdsImpl_EnableEntities function
#macro( ddsImplC_DdsImpl_EnableEntities $systemModel )
int DdsImpl_EnableEntities(void)
{
    DDS_ReturnCode_t retcode;
    if (application == NULL) {
        printf("DdsImpl_EnableEntities: application is NULL\n");      
        return -1;
    }
    #foreach( $library in $systemModel.libraries )
        #foreach( $participant in $library.participants )
    retcode = DDS_Entity_enable(DDS_DomainParticipant_as_entity(application->${participant.name}));
    if (retcode != DDS_RETCODE_OK) {
        printf("DdsImpl_EnableEntities: Failed to enable participant "
            "${participant.libraryName}::${participant.name}\n");
        return -1;
    }
        #end
    #end
    
    return 0;
}
#end

## macro to implement the DdsImpl_<topic>_TakeNextSample function
#macro( ddsImplC_DdsImpl_TakeNextSample $participant $subscriber $datareader )
    #set( $type = $datareader.typeRef )
    #set( $topic = $datareader.topicName )
    int DdsImpl_${topic}_TakeNextSample(dds_${type}* dds_sample, int* is_valid)
    {
        DDS_ReturnCode_t retcode;
        struct DDS_SampleInfo sample_info = DDS_SampleInfo_INITIALIZER;
        DDS_DataReader *datareader_untyped = NULL;
        static dds_${type}DataReader *datareader = NULL;
        const char *datareader_name = "${subscriber.name}::${datareader.name}";

        if (dds_sample == NULL || is_valid == NULL)
        {
            return -1;
        }

        datareader_untyped = DDS_DomainParticipant_lookup_datareader_by_name(
            application->${participant.name}, 
            datareader_name);
        if (datareader_untyped == NULL)
        {
            printf("DdsImpl_${topic}_TakeNextSample: datareader_untyped == NULL\n");
            return -1;
        }

        datareader = dds_${type}DataReader_narrow(datareader_untyped);
        if (datareader == NULL)
        {
            printf("DdsImpl_${topic}_TakeNextSample: datareader == NULL\n");
            return -1;
        }

        *is_valid = 0;

        /* Take next sample from DataReader */
        retcode = dds_${type}DataReader_take_next_sample(
            datareader,
            dds_sample,
            &sample_info);

        if (retcode == DDS_RETCODE_NO_DATA)
        {
            /* No data available - not an error */
            return 0;
        }

        if (retcode != DDS_RETCODE_OK)
        {
            printf("DdsImpl_${topic}_TakeNextSample: Failed to take sample, retcode(%d)\n", retcode);
            return -1;
        }

        /* Check if the sample contains valid data */
        if (sample_info.valid_data)
        {
            *is_valid = 1;
        }

        return 0;
    }
#end

## macro to implement the DdsImpl_<topic>_Write function
#macro( ddsImplC_DdsImpl_WriteFunction $participant $publisher $datawriter )
    #set( $type = $datawriter.typeRef )
    #set( $topic = $datawriter.topicName )
    int DdsImpl_${topic}_WriteSample(const dds_${type}* dds_sample)
    {
        DDS_ReturnCode_t retcode;
        DDS_DataWriter *datawriter_untyped = NULL;
        static dds_${type}DataWriter *datawriter = NULL;
        const char *datawriter_name = "${publisher.name}::${datawriter.name}";

        if (dds_sample == NULL)
        {
            return -1;
        }

        datawriter_untyped = DDS_DomainParticipant_lookup_datawriter_by_name(
                application->${participant.name},
                datawriter_name);
        if (datawriter_untyped == NULL)
        {
            printf("DdsImpl_${topic}_WriteSample: datawriter_untyped == NULL\n");
            return -1;
        }
        datawriter = dds_${type}DataWriter_narrow(datawriter_untyped);
        if (datawriter == NULL)
        {
            printf("DdsImpl_${topic}_WriteSample: datawriter == NULL\n");
            return -1;
        }

        /* Write sample to DDS DataWriter */
        retcode = dds_${type}DataWriter_write(
            datawriter,
            dds_sample,
            &DDS_HANDLE_NIL);

        if (retcode != DDS_RETCODE_OK)
        {
            printf("DdsImpl_${topic}_WriteSample: Failed to write sample, retcode(%d)\n", retcode);
            return -1;
        }

        return 0;
    }
#end