#parse( "utils/utils.vm" )

## macro to print out the header for the dds_impl.h file
#macro( ddsImplH_Header $inputFilePrefix )
/**
 * @file dds_impl.h
 * @brief DDS Implementation Layer Interface (Layer 3)
 * 
 * This file provides the pure DDS implementation interface isolated from AUTOSAR concerns.
 * It handles DDS entity creation, configuration, and data transfer operations.
 * 
 * @details
 * **Architecture**: Layer 3 of the DDS CDD three-layer architecture
 * - Layer 1: RTE Template (DdsCdd.c) - AUTOSAR runnables (integrator implements)
 * - Layer 2: Adapter (dds_cdd_adapter.c) - AUTOSAR/DDS bridge
 * - Layer 3: DDS Implementation (dds_impl.c) - Pure DDS operations
 * 
 * **Responsibilities**:
 * - Create and manage DDS entities (DomainParticipant, Topics, DataWriters, DataReaders)
 * - Load configuration from ${inputFilePrefix}.xml via Application Generation plugin
 * - Provide read/write operations for data transfer
 * - Expose entity handles for adapter layer access
 * 
 * **Configuration**:
 * - All DDS entities are configured via ${inputFilePrefix}.xml
 * - QoS profiles defined in XML are automatically applied
 * - Entity names must match XML configuration
 * - Type support generated by rtiddsgen from IDL
 * 
 * @note This layer has no AUTOSAR dependencies and could be reused in non-AUTOSAR contexts.
 */
#end

## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## macro to define the Application struct with all DomainParticipants in an
## application
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( applicationStruct $application )
    struct Application
    {
    #foreach( $participant in $application.domainParticipant )
        DDS_DomainParticipant *${participant.name};
    #end
    };
#end

## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## macro to include the necessary header files
## - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#macro( ddsImplH_includeHeader $typeFilePrefix )
    ${hashtag}include "#headerInclude()${typeFilePrefix}.h"  /* DDS type definition generated from IDL */
             
        ${hashtag}if (OSAPI_ENABLE_LOG == 1 && OSAPI_ENABLE_TRACE == 1)
            /* TODO: Depend on each platform, change to appropriate logging function */
            //${hashtag}define printf serialprintf
            /* workaround#HAE - don't use serialprintf */
            ${hashtag}define printf(...) do {} while(0) 
        /* Woraround#VTT - cprintf */
        ${hashtag}elif VVIRTUALTARGET
            extern void CANoeAPI_Printf(const char*, ...);
            ${hashtag}define cprintf CANoeAPI_Printf
        ${hashtag}else
            ${hashtag}define printf(...) do {} while(0)  /* No-op when printf is disabled */
        ${hashtag}endif
#end

## macro to print out the description for the dds_impl.h file
#macro( ddsImplH_init_pubsub $typesList $inputFilePrefix )
/**
 * @brief Initialize DDS entities for publish/subscribe operations (Layer 3: DDS Implementation)
 * 
 * Creates and configures all DDS entities required for communication. All entities
 * are created in DISABLED state and must be explicitly enabled via enable_entities().
 * 
 * @details
 * **Initialization Sequence**:
 * 1. Get DomainParticipantFactory and Registry
 * 2. Configure factory to NOT auto-enable entities (if DDS_CONFIG_AUTOENABLE_ENTITIES=0)
 * 3. Register Application Generation plugin (loads ${inputFilePrefix}.xml)
 * 4. Create DomainParticipant from XML configuration (by name)
 * 5. Lookup DataWriter by name (from participant)
 * 6. Narrow DataWriter to type-specific writer
 * 7. Lookup DataReader by name (from participant)
 * 8. Narrow DataReader to type-specific reader
 * 9. Create sample data structure
 * 
 * **Entity Configuration**:
 * - DomainParticipant: Created from ${inputFilePrefix}.xml with name `participant_name`
 * - DataWriter: Looked up by `dataWriter_name`, must exist in XML
 * - DataReader: Looked up by `dataReader_name`, must exist in XML
 * - All QoS profiles applied automatically from XML
 * 
 * **Memory Management**:
 * - Uses AUTOSAR-configured heap (see dds_cdd_adapter.c)
 * - Sample allocated via TypeSupport_create_data()
 * - Entities persist until application shutdown
 * 
 * @param[in] participant_name Name of DomainParticipant in ${inputFilePrefix}.xml
 * @param[in] dataWriter_name Full name of DataWriter (e.g., "Pub::DataWriter")
 * @param[in] dataReader_name Full name of DataReader (e.g., "Sub::DataReader")
 * 
 * @return 0 on success, -1 on error
 * 
 * @retval 0  All entities created successfully (but disabled)
 * @retval -1 Entity creation failed (check logs for details)
 * 
 * @pre 
 * - OSAPI system properties must be set (via dds_cdd_adapter.c)
 * - ${inputFilePrefix}.xml must be accessible and valid
 * - Type support must be registered (#foreach( $type in $typesList) ${type}.h #end)
 * 
 * @post 
 * - All DDS entities created but DISABLED
 * - Call enable_entities() to start communication
 * - Entity handles available via getter functions
 * 
 * @note Entity names are case-sensitive and must exactly match ${inputFilePrefix}.xml.
 * 
 * @see enable_entities()
 * @see get_participant()
 * @see get_datawriter()
 * @see get_datareader()
 */
sint8 init_pubsub(char * participant_name, char * dataWriter_name, char * dataReader_name);
#end

## macro to declare the DdsImpl_CreateEntities function
#macro( ddsImplH_createEntitiesFunctionDeclaration $inputFilePrefix )
/**
 * @brief Create DDS DomainParticipant and child entities
 * 
 * Creates DomainParticipant from XML configuration in DISABLED state.
 * Entities must be explicitly enabled via DdsImpl_EnableEntities().
 * 
 * @return 0 on success, -1 on error
 * 
 * @pre System properties must be set, ${inputFilePrefix}.xml must be valid
 * @post DomainParticipant created but disabled
 */
int DdsImpl_CreateEntities(void);
#end

## macro to define the DdsImpl_EnableEntities function declaration
#macro( ddsImplH_enableEntitiesFunctionDeclaration )
/**
 * @brief Enable DDS entities for communication
 * 
 * Enables DomainParticipant which transitively enables all child entities.
 * DDS communication can begin after this call.
 * 
 * @return 0 on success, -1 on error
 * 
 * @pre DdsImpl_CreateEntities() must have completed successfully
 * @post DDS communication active
 */
int DdsImpl_EnableEntities(void);
#end

## macro to define the DDS take sample function for a given DataReader
#macro( ddsImplH_takeSampleFunctionDeclaration $datareader )
    #set( $type = $datareader.typeRef )
    #set( $topic = $datareader.topicName )
/**
 * @brief Take next ${topic} sample from DDS DataReader
 *
 * This function takes the next available ${topic} sample from the DDS DataReader
 * using the take_next_sample API. It handles only DDS-specific operations.
 *
 * @param[out] dds_sample Pointer to dds_${type} structure to receive DDS data
 * @param[out] is_valid Set to 1 if valid data received, 0 if no data or invalid
 * @return 0 on success (data available or no data), -1 on error
 */
int DdsImpl_${topic}_TakeNextSample(dds_${type}* dds_sample, int* is_valid);
#end

## macro to define the DDS write function for a given DataWriter
#macro( ddsImplH_writeFunctionDeclaration $datawriter )
    #set( $type = $datawriter.typeRef )
    #set( $topic = $datawriter.topicName )
/**
 * @brief Write ${topic} sample to DDS DataWriter
 *
 * This function writes an ${topic} sample to the DDS DataWriter.
 * It handles only DDS-specific operations.
 *
 * @param[in] dds_sample Pointer to dds_${type} structure containing data to write
 * @return 0 on success, -1 on error
 */
int DdsImpl_${topic}_WriteSample(const dds_${type}* dds_sample);
#end