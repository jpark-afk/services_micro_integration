<?xml version="1.0" encoding="utf-8"?>
#parse( "utils/utils.vm" )
#parse( "autosar/application/autosar_model/application_macro.arxml.vm" )
#set($typesList = [])
#set($topicsList = [])
#generate_ar_topic_list()
#generate_type_list()

<!--This file was saved with a tool from Vector Informatik GmbH-->
<AUTOSAR xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00053.xsd" xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AR-PACKAGES>
    ## - - - - - - - - - - - - - - - -
    ## Defines component types       |
    ## - - - - - - - - - - - - - - - -
    <AR-PACKAGE>
      <SHORT-NAME>ComponentTypes</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>${systemModel.appName}Type</SHORT-NAME>
          <PORTS>
          #foreach( $library in $systemModel.libraries )
            #foreach( $participant in $library.participants )
              #foreach( $publisher in $participant.publishers )
                #foreach( $datawriter in $publisher.dataWriters )
                  #set( $topic = $datawriter.topicName )
                  #set( $type = $datawriter.typeRef )
                  ## Defines send ports for each topics
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>S_${topic}</SHORT-NAME>
              <PROVIDED-COM-SPECS>
                <NONQUEUED-SENDER-COM-SPEC>
                  <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/${topic}/${type}</DATA-ELEMENT-REF>
                  <HANDLE-OUT-OF-RANGE>NONE</HANDLE-OUT-OF-RANGE>
                  <USES-END-TO-END-PROTECTION>false</USES-END-TO-END-PROTECTION>
                  <INIT-VALUE>
                    <RECORD-VALUE-SPECIFICATION>
                      <FIELDS>
                        <NUMERICAL-VALUE-SPECIFICATION>
                          <SHORT-LABEL>ElementConstant</SHORT-LABEL>
                          <VALUE>0</VALUE>
                        </NUMERICAL-VALUE-SPECIFICATION>
                      </FIELDS>
                    </RECORD-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </NONQUEUED-SENDER-COM-SPEC>
              </PROVIDED-COM-SPECS>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/${topic}</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
                #end ## end datawriter loop
              #end ## end publisher loop
              #foreach( $subscriber in $participant.subscribers )
                #foreach( $datareader in $subscriber.dataReaders )
                  #set( $topic = $datareader.topicName )
                  #set( $type = $datareader.typeRef )
                  ## Defines receive ports for each topics
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>R_${topic}</SHORT-NAME>
              <REQUIRED-COM-SPECS>
                <NONQUEUED-RECEIVER-COM-SPEC>
                  <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/${topic}/${type}</DATA-ELEMENT-REF>
                  <HANDLE-OUT-OF-RANGE>NONE</HANDLE-OUT-OF-RANGE>
                  <USES-END-TO-END-PROTECTION>false</USES-END-TO-END-PROTECTION>
                  <ALIVE-TIMEOUT>0</ALIVE-TIMEOUT>
                  <ENABLE-UPDATE>false</ENABLE-UPDATE>
                  <!-- Workaround#HAE - delete unnecessary elements
                  <FILTER>
                    <DATA-FILTER-TYPE>ALWAYS</DATA-FILTER-TYPE>
                  </FILTER>
                  -->
                  <HANDLE-NEVER-RECEIVED>false</HANDLE-NEVER-RECEIVED>
                  <INIT-VALUE>
                    <RECORD-VALUE-SPECIFICATION>
                      <FIELDS>
                        <NUMERICAL-VALUE-SPECIFICATION>
                          <SHORT-LABEL>ElementConstant</SHORT-LABEL>
                          <VALUE>0</VALUE>
                        </NUMERICAL-VALUE-SPECIFICATION>
                      </FIELDS>
                    </RECORD-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </NONQUEUED-RECEIVER-COM-SPEC>
              </REQUIRED-COM-SPECS>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/${topic}</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
                #end ## end datareader loop
              #end ## end subscriber loop
            #end ## end participant loop
          #end ## end library loop
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>${systemModel.appName}Type_InternalBehavior</SHORT-NAME>
              <EVENTS>
                <INIT-EVENT>
                  <SHORT-NAME>InitEvent</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/${systemModel.appName}Type/${systemModel.appName}Type_InternalBehavior/Init</START-ON-EVENT-REF>
                </INIT-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>TMT_Runnable</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/${systemModel.appName}Type/${systemModel.appName}Type_InternalBehavior/Periodic</START-ON-EVENT-REF>
                  <PERIOD>1</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <HANDLE-TERMINATION-AND-RESTART>NO-SUPPORT</HANDLE-TERMINATION-AND-RESTART>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Init</SHORT-NAME>
                  <ADMIN-DATA>
                    <SDGS>
                      <SDG GID="edve:RunnableKind">
                        <SD>InitRunnable</SD>
                      </SDG>
                    </SDGS>
                  </ADMIN-DATA>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <SYMBOL>Init</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Periodic</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>

                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  #foreach( $library in $systemModel.libraries )
                    #foreach( $participant in $library.participants )
                      #foreach( $subscriber in $participant.subscribers )
                        #foreach( $datareader in $subscriber.dataReaders )
                          #set( $topic = $datareader.topicName )
                          #set( $type = $datareader.typeRef )
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>REC_R_${topic}_${type}</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/${systemModel.appName}Type/R_${topic}</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/${topic}/${type}</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                        #end ## end datareader loop
                      #end ## end subscriber loop
                    #end ## end participant loop
                  #end ## end library loop
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>

                  <DATA-SEND-POINTS>
                  #foreach( $library in $systemModel.libraries )
                    #foreach( $participant in $library.participants )
                      #foreach( $publisher in $participant.publishers )
                        #foreach( $datawriter in $publisher.dataWriters )
                          #set( $topic = $datawriter.topicName )
                          #set( $type = $datawriter.typeRef )
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>SEND_S_${topic}_${type}</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/ComponentTypes/${systemModel.appName}Type/S_${topic}</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/${topic}/${type}</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                        #end ## end datawriter loop
                      #end ## end publisher loop
                    #end ## end participant loop
                  #end ## end library loop
                  </DATA-SEND-POINTS>

                  <SYMBOL>Periodic</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
              <SUPPORTS-MULTIPLE-INSTANTIATION>false</SUPPORTS-MULTIPLE-INSTANTIATION>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
          <SYMBOL-PROPS>
            <SHORT-NAME>${systemModel.appName}</SHORT-NAME>
            <SYMBOL>${systemModel.appName}</SYMBOL>
          </SYMBOL-PROPS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <SWC-IMPLEMENTATION>
          <SHORT-NAME>${systemModel.appName}Type_Implementation</SHORT-NAME>
          <CODE-DESCRIPTORS>
            <CODE>
              <SHORT-NAME>Default</SHORT-NAME>
              <ARTIFACT-DESCRIPTORS>
                <AUTOSAR-ENGINEERING-OBJECT>
                  <SHORT-LABEL>Default</SHORT-LABEL>
                  <CATEGORY>SWSRC</CATEGORY>
                </AUTOSAR-ENGINEERING-OBJECT>
              </ARTIFACT-DESCRIPTORS>
            </CODE>
          </CODE-DESCRIPTORS>
          <BEHAVIOR-REF DEST="SWC-INTERNAL-BEHAVIOR">/ComponentTypes/${systemModel.appName}Type/${systemModel.appName}Type_InternalBehavior</BEHAVIOR-REF>
        </SWC-IMPLEMENTATION>
      </ELEMENTS>
    </AR-PACKAGE> ## End of ComponentTypes
    <!-- Workaround#COMMON - delete duplated port inteface definition -->
